{
  "reviewedSourceSha256": "0a517d64cabf819434c46efc3114453ff75b747b31f21652a418e0206971e272",
  "beforeAccountLine": " <section className=\"panel\"><div className=\"panel-head\"><h2>账号数据</h2><label>账号状态<select value={rosterStatus} onChange={e=>setRosterStatus(e.target.value)}><option value=\"enabled\">启用账号</option><option value=\"paused\">暂停账号（历史）</option><option value=\"all\">全部账号</option></select></label><Input ref={searchRef} className=\"search\" maxLength={200} value={query} placeholder=\"搜索作者名称\" aria-label=\"搜索作者\" onChange={e=>setQuery(e.target.value)}/><Button variant=\"outline\" onClick={()=>download(accountExport(sorted,data.manifest,start,end),'矩阵账号-'+start+'-'+end+'.csv')}>导出全部结果</Button></div><p className=\"meta\">名称搜索与账号状态只筛选下方列表和导出；经营卡片始终统计所选矩阵、主题、分类的启用账号。导出包含稳定账号编号、平台、真实端点时间与公开日历史分区指纹。</p><div className=\"list-context\" aria-label=\"当前列表排序\"><span>当前排序 <strong>{(workspaceSortLabels as Record<string,string>)[sort]} · {order==='asc'?'升序 ↑':'降序 ↓'}</strong></span><small>缺测始终置后 · 点击列名切换方向</small></div>{pager(sorted.length,page,setPage)}<Table><TableHeader><TableRow><TableHead aria-sort={sort==='label'?(order==='asc'?'ascending':'descending'):'none'}><Button variant=\"ghost\" onClick={()=>rank('label')}>作者{sort==='label'?(order==='asc'?' ↑':' ↓'):''}</Button></TableHead>{[['followers.value','粉丝'],['followers.delta','粉丝变化'],['likes.value','点赞'],['likes.delta','点赞变化'],['posts.value','作品存量'],['posts.delta','作品变化']].map(([key,label])=><TableHead key={key} aria-sort={sort===key?(order==='asc'?'ascending':'descending'):'none'}><Button variant=\"ghost\" onClick={()=>rank(key)}>{label}{sort===key?(order==='asc'?' ↑':' ↓'):''}</Button></TableHead>)}</TableRow></TableHeader><TableBody>{sorted.slice((page-1)*20,page*20).map((a:Row)=><TableRow key={a.id}><TableCell><Button type=\"button\" className=\"author\" variant=\"link\" aria-label={`查看${a.label}的经营详情`} onClick={e=>standalone(a,e.currentTarget)}>{a.label}</Button><div className=\"account-row-actions\"><Button type=\"button\" variant=\"ghost\" aria-label={`查看${a.label}的经营详情`} onClick={e=>standalone(a,e.currentTarget)}>经营详情</Button><Button type=\"button\" variant=\"ghost\" aria-label={`查看${a.label}的历史`} onClick={e=>open(a,e.currentTarget)}>历史</Button></div><small>{a.enabled?'启用':'暂停 · 仅历史'}</small><AccountClassification classification={a.classification}/></TableCell>{['followers','likes','posts'].flatMap(k=>[<TableCell key={k+'v'}>{fmt(a.metrics[k].value)}</TableCell>,<TableCell key={k+'d'} className={a.metrics[k].delta<0?'negative':a.metrics[k].delta>0?'positive':''}>{diff(a.metrics[k].delta)}</TableCell>])}</TableRow>)}</TableBody></Table>{!sorted.length&&<p className=\"empty\">当前范围没有账号，请调整筛选。</p>}{pager(sorted.length,page,setPage)}</section></div>;",
  "afterAccountLine": " <section className=\"panel\"><div className=\"panel-head\"><h2>账号数据</h2><label>账号状态<select value={rosterStatus} onChange={e=>setRosterStatus(e.target.value)}><option value=\"enabled\">启用账号</option><option value=\"paused\">暂停账号（历史）</option><option value=\"all\">全部账号</option></select></label><Input ref={searchRef} className=\"search\" maxLength={200} value={query} placeholder=\"搜索作者名称\" aria-label=\"搜索作者\" onChange={e=>setQuery(e.target.value)}/><Button variant=\"outline\" onClick={()=>download(accountExport(sorted,data.manifest,start,end),'矩阵账号-'+start+'-'+end+'.csv')}>导出全部结果</Button></div><p className=\"meta\">名称搜索与账号状态只筛选下方列表和导出；经营卡片始终统计所选矩阵、主题、分类的启用账号。导出包含稳定账号编号、平台、真实端点时间与公开日历史分区指纹。</p><div className=\"list-context\" aria-label=\"当前列表排序\"><div className=\"follower-sort-shortcuts\" role=\"group\" aria-label=\"粉丝变化快捷排序\" aria-describedby=\"follower-sort-help\">{([[\"desc\",\"涨粉优先\"],[\"asc\",\"掉粉优先\"]] as const).map(([direction,label])=><Button key={direction} type=\"button\" variant={sort==='followers.delta'&&order===direction?'secondary':'outline'} aria-pressed={sort==='followers.delta'&&order===direction} onClick={()=>{setSort('followers.delta');setOrder(direction);}}>{label}</Button>)}</div><span>当前排序 <strong>{(workspaceSortLabels as Record<string,string>)[sort]} · {order==='asc'?'升序 ↑':'降序 ↓'}</strong></span><small id=\"follower-sort-help\">按所选区间粉丝净变化排序，不筛掉账号 · 缺测始终置后</small></div>{pager(sorted.length,page,setPage)}<Table><TableHeader><TableRow><TableHead aria-sort={sort==='label'?(order==='asc'?'ascending':'descending'):'none'}><Button variant=\"ghost\" onClick={()=>rank('label')}>作者{sort==='label'?(order==='asc'?' ↑':' ↓'):''}</Button></TableHead>{[['followers.value','粉丝'],['followers.delta','粉丝变化'],['likes.value','点赞'],['likes.delta','点赞变化'],['posts.value','作品存量'],['posts.delta','作品变化']].map(([key,label])=><TableHead key={key} aria-sort={sort===key?(order==='asc'?'ascending':'descending'):'none'}><Button variant=\"ghost\" onClick={()=>rank(key)}>{label}{sort===key?(order==='asc'?' ↑':' ↓'):''}</Button></TableHead>)}</TableRow></TableHeader><TableBody>{sorted.slice((page-1)*20,page*20).map((a:Row)=><TableRow key={a.id}><TableCell><Button type=\"button\" className=\"author\" variant=\"link\" aria-label={`查看${a.label}的经营详情`} onClick={e=>standalone(a,e.currentTarget)}>{a.label}</Button><div className=\"account-row-actions\"><Button type=\"button\" variant=\"ghost\" aria-label={`查看${a.label}的经营详情`} onClick={e=>standalone(a,e.currentTarget)}>经营详情</Button><Button type=\"button\" variant=\"ghost\" aria-label={`查看${a.label}的历史`} onClick={e=>open(a,e.currentTarget)}>历史</Button></div><small>{a.enabled?'启用':'暂停 · 仅历史'}</small><AccountClassification classification={a.classification}/></TableCell>{['followers','likes','posts'].flatMap(k=>[<TableCell key={k+'v'}>{fmt(a.metrics[k].value)}</TableCell>,<TableCell key={k+'d'} className={a.metrics[k].delta<0?'negative':a.metrics[k].delta>0?'positive':''}>{diff(a.metrics[k].delta)}</TableCell>])}</TableRow>)}</TableBody></Table>{!sorted.length&&<p className=\"empty\">当前范围没有账号，请调整筛选。</p>}{pager(sorted.length,page,setPage)}</section></div>;",
  "addedCssRules": [
    ".follower-sort-shortcuts {display:flex;flex-wrap:wrap;gap:8px;}",
    ".follower-sort-shortcuts button {min-height:44px;}",
    ".follower-sort-shortcuts button[aria-pressed=\"true\"] {border:1px solid var(--mcn-ink);}"
  ]
}
